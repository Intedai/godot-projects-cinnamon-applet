{
    "head": {
        "type": "header",
        "description": "Godot Projects Applet Settings"    
    },
    "use-monochrome-icon": {
        "type": "switch",
        "default": true,
        "description": "Use a monochrome icon"
    },
    "show-full-path": {
        "type": "switch",
        "default": false,
        "description": "Show full path instead of project name"
    },
    "show-star-icons": {
        "type": "switch",
        "default": true,
        "description": "Show star icons near every project"
    },
    "add-launch-godot": {
        "type": "switch",
        "default": false,
        "description": "Add a button that launches Godot"
    },
    "launch-godot-fg-color": {
        "type": "colorchooser",
        "default": "white",
        "dependency": "add-launch-godot=true",
        "description": "Choose a text color for the launch button"
    },
    "launch-godot-bg-color": {
        "type": "colorchooser",
        "default": "#097fd6",
        "dependency": "add-launch-godot=true",
        "description": "Choose a background color for the launch button"
    },
    "godot-command": {
        "type": "entry",
        "default": "godot",
        "description": "Godot command",
        "tooltip": "For example: godot, flatpak run org.godotengine.Godot or ./{EXECUTABLE PATH}"
    },
    "godot-flags": {
        "type": "entry",
        "default": "--editor --path",
        "description": "Godot flags"
    },
    "custom-projects-path": {
        "type": "switch",
        "default": false,
        "description": "Use a custom path for projects.cfg",
        "tooltip": "Usually for a Flatpak"
    },
    "projects-file-uri": {
        "type": "filechooser",
        "default": "",
        "dependency": "custom-projects-path=true",
        "description": "Choose your projects.cfg file",
        "tooltip": "Usually ~/.local/share/godot/project.cfg or for flatpak ~/.var/app/org.godotengine.Godot/data/godot"
    }
}
